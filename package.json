{
	"name": "companion-module-disguise-session",
	"version": "1.1.1",
	"description": "Bitfocus Companion module \"Disguise: Session API\" (Designer Show Control) – controls disguise Designer through the session API: transports, sections, cues, timecode, master fade, layers, machine health and failover.",
	"main": "src/main.mjs",
	"license": "MIT",
	"author": {
		"name": "Lucas Hoyer",
		"email": "lh@lightartstudios.de",
		"url": "https://lightartstudios.de"
	},
	"contributors": [
		"Light Art Studios GmbH"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Light-Art-Studios-GmbH/companion-module-disguise-session.git"
	},
	"bugs": {
		"url": "https://github.com/Light-Art-Studios-GmbH/companion-module-disguise-session/issues"
	},
	"homepage": "https://github.com/Light-Art-Studios-GmbH/companion-module-disguise-session#readme",
	"keywords": [
		"companion",
		"bitfocus",
		"disguise",
		"d3",
		"designer",
		"session",
		"transport",
		"timecode",
		"api"
	],
	"files": [
		"src/",
		"companion/",
		"README.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"scripts": {
		"format": "prettier -w .",
		"lint": "eslint",
		"lint:fix": "eslint --fix",
		"check": "node --check src/main.mjs && for f in src/*.js scripts/*.js test/*.js; do node --check \"$f\" || exit 1; done",
		"test": "node test/logic.test.js",
		"icons": "node scripts/build-icons.js",
		"package": "companion-module-build",
		"deploy": "rsync -a --delete --exclude .git --exclude .DS_Store --exclude pkg --exclude '*.tgz' ./ \"${COMPANION_DEV_MODULES:-$HOME/Documents/Companion Developer Modules}/companion-module-disguise-session/\""
	},
	"dependencies": {
		"@companion-module/base": "^2.1.3"
	},
	"devDependencies": {
		"@companion-module/tools": "^3.1.0",
		"eslint": "^9.39.5",
		"prettier": "^3.8.1",
		"typescript-eslint": "^8.56.1"
	},
	"engines": {
		"node": "^22.20"
	},
	"prettier": "@companion-module/tools/.prettierrc.json"
